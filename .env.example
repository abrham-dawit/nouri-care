# Copy to .env.local (which is git-ignored) and fill in locally.
# Never commit real keys, paste them into chat, or expose them to browser code.

# ── Conversation + visit brief ──
# Claude is used when set (recommended). Otherwise OpenAI; with neither, a deterministic rule-based mock.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=

# Optional. Also enables OpenAI speech-to-text and voices for the device (POST /api/v1/voice).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
# Leave empty to use the patient's Voice Studio personality (nova / alloy / shimmer).
OPENAI_TTS_VOICE=

# ── Nouri's voice (ElevenLabs, recommended) ──
# Used first for spoken replies when both are set; Windows voices take over if ElevenLabs fails.
# The voice ID is on the voice's page in ElevenLabs (e.g. "Elise", after "Add to my voices").
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_flash_v2_5 (fast, multilingual).
# ELEVENLABS_MODEL=

# ── Device speech without OpenAI ──
# Speech-to-text: Groq's hosted Whisper if GROQ_API_KEY is set, otherwise Whisper running locally
# (model downloaded once, ~80 MB). Set NOURI_LOCAL_STT=0 to turn local Whisper off.
# GROQ_API_KEY=
# NOURI_LOCAL_STT_MODEL=onnx-community/whisper-base
# Replies: the voices built into Windows. Set NOURI_WINDOWS_TTS=0 to turn them off.

# ── Logins ──
# Required. Signs login cookies: any random string of 32+ characters. Changing it signs everyone out.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOURI_SESSION_SECRET=
# Set to 1 when serving over HTTPS so cookies are only sent securely.
# NOURI_SECURE_COOKIES=1

# Testing only: lets scripts/test-voice.ps1 -TestTranscript stand in for speech-to-text.
# NOURI_ALLOW_TEST_TRANSCRIPT=1
